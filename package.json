{
  "name": "freellmapi",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @freellmapi/server dev\" \"pnpm --filter @freellmapi/client dev\"",
    "test": "pnpm --filter @freellmapi/server test && pnpm --filter @freellmapi/client test",
    "build": "pnpm --filter @freellmapi/server build && pnpm --filter @freellmapi/client build",
    "build:server": "pnpm --filter @freellmapi/server build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
