  },
  "dependencies": {
    "@freellmapi/shared": "*",
    "hono": "^4.12.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260521.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "wrangler": "^4.59.1"
  }
}
